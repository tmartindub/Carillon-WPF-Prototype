<Application x:Class="Carillon.WpfPrototype.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#173650"/>
  <SolidColorBrush x:Key="Muted" Color="#617589"/>
  <SolidColorBrush x:Key="Accent" Color="#D87732"/>
  <SolidColorBrush x:Key="Line" Color="#DCE5EB"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Canvas" Color="#EFF3F6"/>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="FontFamily" Value="Bahnschrift"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="Bahnschrift"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="#F4F7F9"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Shell" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.78"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#D87732"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#D87732"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#D87732"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style TargetType="DatePicker">
   <Setter Property="FontFamily" Value="Bahnschrift"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Padding" Value="5"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F0F4F7"/><Setter Property="Foreground" Value="#617589"/>
   <Setter Property="FontSize" Value="11"/><Setter Property="FontFamily" Value="Bahnschrift"/>
   <Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,0"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDEBF5"/><Setter Property="Foreground" Value="#173650"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="22"/>
  </Style>
 </Application.Resources>
</Application>
